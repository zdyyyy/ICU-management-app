{
  "name": "icu-resource-manager",
  "version": "0.1.0",
  "description": "Hospital/ICU resource and patient flow management - Ottawa context",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "client:install": "npm install --prefix client",
    "client:dev": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "extract:guideline-metadata": "node scripts/extract-guideline-metadata.js",
    "promote:guideline-metadata": "node scripts/promote-guideline-metadata.js",
    "build:guideline-index-input": "node scripts/build-guideline-index-input.js",
    "build:guideline-chunks": "node scripts/build-guideline-chunks.js",
    "embed:guideline-chunks": "node scripts/embed-guideline-chunks.js",
    "docker:build": "docker build -t icu-resource-manager:latest .",
    "k8s:apply": "kubectl apply -k k8s/"
  },
  "keywords": [
    "hospital",
    "icu",
    "triage",
    "bed-management",
    "ottawa"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.0",
    "openai": "^6.27.0",
    "pdf-parse": "^2.4.5"
  }
}
